def dfs_detectar_ciclo(grafo, nodo_actual, visitado, padre):
    " Función auxiliar recursiva que recorre el grafo en profundidad (DFS) buscando retrocesos que formen ciclos. "
    
    visitado.add(nodo_actual)
    
    # Recorremos todos los vecinos del nodo actual
    for vecino in grafo.get(nodo_actual, {}): # Si el vecino no fue visitado, bajamos recursivamente por él
        if vecino not in visitado:
            
            if dfs_detectar_ciclo(grafo, vecino, visitado, nodo_actual):
                
                return True  # Si el vecino ya fue visitado y NO es el padre, hay un ciclo
        
        elif vecino != padre:
            
            return True
            
    return False

def tiene_ciclos(grafo):   #Función principal que evalúa todo el grafo.

    visitado = set()
    
    for nodo in grafo:
        if nodo not in visitado:
            if dfs_detectar_ciclo(grafo, nodo, visitado, None):
                return True # Encontró al menos un ciclo
                
    return False # El grafo es acíclico

