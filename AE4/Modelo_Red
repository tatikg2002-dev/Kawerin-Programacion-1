def obtener_nodos(lista_ady):
    nodos = []
    for clave in lista_ady:
        nodos.append(clave)
    return nodos


def buscar_en_lista(lista, valor): # Busqueda secuencial manual
    i = 0
    pos = -1
    while i < len(lista) and pos == -1:
        if lista[i] == valor:
            pos = i
        i = i + 1
    return pos


def ordenar_seleccion(lista): # Ordenamiento por seleccion
    n = len(lista)
    for i in range(n - 1):
        pos_min = i
        for j in range(i + 1, n):
            if lista[j] < lista[pos_min]:
                pos_min = j
        aux = lista[i]
        lista[i] = lista[pos_min]
        lista[pos_min] = aux


def busqueda_binaria(vector, clave): # Busqueda binaria sobre lista ordenada
    inicio = 0
    fin = len(vector) - 1
    pos = -1
    while inicio <= fin and pos == -1:
        medio = (inicio + fin) // 2
        if vector[medio] == clave:
            pos = medio
        elif clave < vector[medio]:
            fin = medio - 1
        else:
            inicio = medio + 1
    return pos

